# Copy to .env to override the docker compose defaults. Never commit .env.

# Turns on the Django debug page and the dev-only secret key. Never true in production.
DEBUG=true
# Required when DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Postgres connection used by Django (the compose "db" service by default).
DATABASE_URL=postgres://smartcare:smartcare@db:5432/smartcare
# Hosts Django will answer for. 10.0.2.2 is the Android emulator's alias for this machine;
# add your LAN IP to test from a real phone.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Time zone for consulting sessions (the demo hospitals are in Kerala).
TIME_ZONE=Asia/Kolkata
